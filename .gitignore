# Dependencies
node_modules/
**/node_modules/

# Build output
frontend/dist/
dist/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp

# Data - generated artifacts (reproducible via npm run data:generate)
data/raw/*
data/processed/*
data/generated/uci/*
data/generated/eval/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Persistence files
data/persist/*.json

# SQLite Database
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Test Databases
backend/tests/fixtures/*.db
backend/tests/fixtures/*.db-shm
backend/tests/fixtures/*.db-wal
