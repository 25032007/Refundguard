{
  "name": "refundguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Explainable AI Risk Manager for detecting coordinated refund-abuse rings",
  "scripts": {
    "setup": "npm run install-all",
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "data:generate": "node data/generate.js",
    "data:uci": "node -e \"if(!require('fs').existsSync('data/processed/online-retail-ii.csv')) require('child_process').execSync('node data/preprocess-uci.js', {stdio:'inherit'})\" && node data/adapters/onlineRetail.js --seed 1",
    "dev:uci": "cross-env REFUNDGUARD_DATA_DIR=data/generated/uci npm run dev",
    "bench:api": "cross-env REFUNDGUARD_DATA_DIR=data/generated/uci node backend/bench.js",
    "data:validate": "node data/validate.js",
    "data:test": "node --test \"data/tests/*.test.js\"",
    "data:ci": "node --test \"data/tests/fixture.test.js\"",
    "risk:analyze": "node risk-engine/run.js",
    "risk:test": "node --test \"risk-engine/tests/*.test.js\"",
    "nlp:analyze": "node nlp/run.js",
    "nlp:test": "node --test \"nlp/tests/*.test.js\"",
    "graph:analyze": "node graph/run.js",
    "graph:test": "node --test \"graph/tests/*.test.js\"",
    "eval:run": "node evaluation/run.js",
    "eval:ablation": "node evaluation/ablation.js --seeds 1,2,3,4,5",
    "eval:guard": "node evaluation/guard_experiment.js",
    "eval:final": "node evaluation/final_evaluation.js",
    "eval:test": "node --test --test-concurrency=1 \"evaluation/tests/*.test.js\"",
    "backend:test": "node --test \"backend/tests/*.test.js\"",
    "frontend:test": "npm run test --prefix frontend",
    "test": "npm run test:ci",
    "test:ci": "node scripts/run-tests.js risk nlp graph data-ci backend frontend",
    "test:full": "node scripts/run-tests.js risk nlp graph data eval backend frontend"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "csv-parser": "^3.2.1",
    "xlsx": "^0.18.5"
  }
}
